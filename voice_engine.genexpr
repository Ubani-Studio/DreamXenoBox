// MAUD — Voice Engine v3
// gen~ codebox: exciter → body → fracture → feedback resonance → memory
// in1 = trigger signal (click~ or sig~), Params for all controls
//
// v3 changes:
// - 4 body types: Resonator Bank, Dispersive Comb, Pressure Cavity, Membrane
// - Non-linear decay: decay_ms squared for exponential feel
//   (dial 0→5ms snap, dial max→6400ms sustain)
// - Pressure Cavity: comb with pressure-dependent feedback — tightens on hard hits
// - Membrane: Bessel function ratios (1.0, 1.594, 2.136, 2.296) for circular modes

Param pitch(60);
Param decay_ms(200);
Param exciter_type(0);
Param body_type(0);
Param stress(0.3);
Param bloom(0.3);
Param scar(0);
Param weight(0.5);
Param mist(0.2);
Param heat_macro(0.3);
Param drift_param(0);
Param density_param(0.5);
Param flam_pitch_off(0);    // semitone offset from flam engine
Param flam_vel(1);           // velocity scale from flam engine
Param flam_pitch_gate(0);   // pitch release: 0=instant snap back, 1=long sustain
Param lfo_pitch_off(0);     // LFO pitch offset (semitones)
Param lfo_stress_off(0);    // LFO stress offset
Param lfo_bloom_off(0);     // LFO bloom offset
Param lfo_decay_off(0);     // LFO decay_ms offset
Param lfo_mist_off(0);      // LFO mist offset
Param lfo_heat_off(0);      // LFO heat_macro offset
Param lfo_drift_off(0);     // LFO drift_param offset
Param lfo_density_off(0);   // LFO density_param offset

History prev_trig(0);
History pressure(0);
History heat_state(0);
History fatigue(0);
History exc_car_phase(0);
History exc_mod_phase(0);
History exc_env(0);
History noise_filt(0);
History ry1_a(0);
History ry2_a(0);
History ry1_b(0);
History ry2_b(0);
History ry1_c(0);
History ry2_c(0);
History ry1_d(0);
History ry2_d(0);
History comb_lp(0);
History halo_env(0);
History main_env(0);
History pitch_env(0);    // pitch sweep envelope
History fb_state(0);     // feedback resonance state (prev body output)
History fb_hp(0);        // feedback highpass filter state
History cav_lp(0);       // pressure cavity lowpass state
History fb_lfo_phase(0); // feedback LFO phase
History fb_lp2(0);       // feedback lowpass state (bloom brightness)
History flam_p_env(0);   // flam pitch envelope (decays toward base pitch)
Delay comb_d(8820);
Delay cav_d(8820);       // pressure cavity delay line

// ── TRIGGER DETECTION ──
trig_on = (in1 > 0.5) * (prev_trig <= 0.5);
vel = in1 * flam_vel;
prev_trig = in1;

if (trig_on) {
    pressure = min(pressure + vel * (0.3 + stress * 0.7) * (1 - pressure), 1);
    fatigue = min(fatigue + 0.02 * (1 - fatigue), 1);
    exc_env = 1;
    halo_env = vel * mist;       // feedback gate opens proportional to mist
    main_env = vel;
    pitch_env = vel;             // start pitch sweep
    flam_p_env = flam_pitch_off; // capture flam pitch offset into envelope
}

// ── STATE DECAY ──
p_decay = 0.00002 + (1 - stress) * 0.00008;
pressure = pressure * (1 - p_decay);
heat_state = heat_state + (pressure - heat_state) * 0.0002;
heat_state = heat_state * (1 - 0.00005);
fatigue = fatigue * (1 - 0.000002);
stiffness = fatigue * 0.6 + pressure * 0.4;

// ── EFFECTIVE PARAMS (base + LFO offsets) ──
eff_stress = clamp(stress + lfo_stress_off, 0, 1);
eff_bloom = clamp(bloom + lfo_bloom_off, 0, 1);
eff_mist = clamp(mist + lfo_mist_off, 0, 1);
eff_heat = clamp(heat_macro + lfo_heat_off + heat_state * 0.5, 0, 1);
eff_drift = clamp(drift_param + lfo_drift_off, 0, 1);
eff_density = clamp(density_param + lfo_density_off, 0, 1);
eff_decay_ms = clamp(decay_ms + lfo_decay_off, 5, 80);
eff_scar = clamp(scar + pressure * eff_stress, 0, 1);

// ── FLAM PITCH ENVELOPE (momentary bend, decays back to base) ──
// gate=0: instant snap (rate~0.15), gate=1: long slide (rate~0.00005)
fp_rate = exp(-(flam_pitch_gate * 8)) * 0.15;
flam_p_env = flam_p_env * (1 - fp_rate);

// ── PITCH ENVELOPE (weight-scaled sweep for sub bass bounce) ──
// Heavy voices (high weight) get large slow sweep = 808 bounce
// Light voices (low weight) get tiny fast sweep = subtle chirp
p_env_rate = 0.002 + weight * 0.008;
pitch_env = pitch_env * (1 - p_env_rate);
p_sweep = pitch_env * weight * 24;  // up to 24 semitones (2 octaves) for max weight
p_mod = pitch + lfo_pitch_off + flam_p_env + p_sweep + noise() * pressure * eff_drift * 2;
base_freq = mtof(clamp(p_mod, 10, 130));
w_scale = 1 - weight * 0.35;
body_freq = max(base_freq * w_scale, 25);

// ── EXCITER ENVELOPE ──
e_decay = 0.0005 + eff_density * 0.003;
exc_env = exc_env * (1 - e_decay);

// ── EXCITER ──
exciter_out = 0;
if (exciter_type < 0.5) {
    // FM impulse click — higher index + heat range for fiercer transients
    fm_r = 1.41 + eff_heat * 3;
    mf = base_freq * fm_r;
    fm_idx = (12 + eff_heat * 18) * exc_env;
    exc_mod_phase = wrap(exc_mod_phase + mf / samplerate, 0, 1);
    mod_sig = sin(exc_mod_phase * twopi) * fm_idx;
    exc_car_phase = wrap(exc_car_phase + base_freq / samplerate, 0, 1);
    exciter_out = sin(exc_car_phase * twopi + mod_sig) * exc_env * 1.5;
} else {
    // Noise burst — wider bandwidth, hotter amplitude
    n = noise();
    cutoff = base_freq * (3 + eff_heat * 12);
    coeff = clamp(1 - exp(-twopi * cutoff / samplerate), 0.001, 0.999);
    noise_filt = noise_filt + (n - noise_filt) * coeff;
    exciter_out = noise_filt * 6 * exc_env;
}

// ── FEEDBACK RESONANCE ──
// Previous body output → highpass → lowpass → tanh limiter → gain → back into body
// mist = feedback amount, stress adds edge
// bloom = feedback sustain + brightness (high bloom = bright shimmering tail)
// Feedback LFO: mist > 0.3 enables, bloom controls rate
fb_lfo_rate = 0.3 + (1 - eff_bloom) * 7.7;
fb_lfo_depth_raw = clamp((eff_mist - 0.3) / 0.7, 0, 1);
fb_lfo_phase = wrap(fb_lfo_phase + fb_lfo_rate / samplerate, 0, 1);
fb_lfo = sin(fb_lfo_phase * twopi);
fb_gain = eff_mist * (0.5 + eff_stress * 0.5) * (1 + fb_lfo * fb_lfo_depth_raw * 0.15);
fb_gain = clamp(fb_gain, 0, 0.95);
// Highpass: wider range (80-2480 Hz). Heavy voices keep low freqs, light voices sparkle
hp_cut_base = 80 + (1 - weight) * 2400;
hp_cut = hp_cut_base * (1 + fb_lfo * fb_lfo_depth_raw * 0.7);
hp_c = clamp(1 - exp(-twopi * hp_cut / samplerate), 0.001, 0.999);
fb_lp = fb_hp + (fb_state - fb_hp) * hp_c;
fb_hp = fb_lp;
fb_hpf = fb_state - fb_lp;
// Lowpass: bloom controls brightness of feedback tail
// bloom=0: dull 800Hz, bloom=1: bright 10.8kHz. LFO sweeps ±3kHz
lp2_cut = 800 + eff_bloom * 10000 + fb_lfo * fb_lfo_depth_raw * 3000;
lp2_c = clamp(1 - exp(-twopi * lp2_cut / samplerate), 0.001, 0.999);
fb_lp2 = fb_lp2 + (fb_hpf - fb_lp2) * lp2_c;
// Soft limit feedback — slightly hotter drive for richer harmonics
fb_ltd = tanh(fb_lp2 * 2.5) * 0.6;
// Feedback envelope: bloom controls sustain duration
bl_rate = 0.000001 + (1 - eff_bloom) * 0.0003;
halo_env = halo_env * (1 - bl_rate);
fb_sig = fb_ltd * fb_gain * halo_env;
body_input = exciter_out + fb_sig;

// ── DECAY (non-linear: squared for exponential feel) ──
// decay_ms dial range [5, 80] + LFO offset. Squared × 2.5: 62ms → 16000ms actual
eff_decay = eff_decay_ms * eff_decay_ms * 2.5;
decay_norm = clamp(eff_decay / 16000, 0, 1);
eff_Q = clamp(0.985 + decay_norm * 0.014 - fatigue * 0.15, 0.85, 0.9995);

// ── BODY ──
// 0: Inharmonic resonator bank — fiercer partial gains, tighter Q spread
// 1: Dispersive comb filter — hotter feedback, louder output
// 2: Pressure cavity — more dramatic pressure response, higher cav_fb
// 3: Membrane (Bessel ratios) — higher Q for longer sustain
body_out = 0;
if (body_type < 0.5) {
    // Type 0: Inharmonic resonator bank
    w1 = twopi * body_freq * 1.0 / samplerate;
    r1 = eff_Q;
    ya = body_input + 2 * r1 * cos(w1) * ry1_a - r1 * r1 * ry2_a;
    ry2_a = ry1_a; ry1_a = ya;
    w2 = twopi * body_freq * (1.347 + stiffness * 0.2) / samplerate;
    r2 = eff_Q * 0.995;
    yb = body_input + 2 * r2 * cos(w2) * ry1_b - r2 * r2 * ry2_b;
    ry2_b = ry1_b; ry1_b = yb;
    w3 = twopi * body_freq * (1.891 + stiffness * 0.25) / samplerate;
    r3 = eff_Q * 0.99;
    yc = body_input + 2 * r3 * cos(w3) * ry1_c - r3 * r3 * ry2_c;
    ry2_c = ry1_c; ry1_c = yc;
    w4 = twopi * body_freq * (2.534 + stiffness * 0.35) / samplerate;
    r4 = eff_Q * 0.985;
    yd = body_input + 2 * r4 * cos(w4) * ry1_d - r4 * r4 * ry2_d;
    ry2_d = ry1_d; ry1_d = yd;
    body_out = (ya + yb * 0.8 + yc * 0.55 + yd * 0.4) * 0.35;
} else if (body_type < 1.5) {
    // Type 1: Dispersive comb filter (uses base_freq for tight timing)
    d_samps = clamp(samplerate / base_freq, 2, 8000);
    fb = eff_Q * 0.92;
    delayed = comb_d.read(d_samps);
    d_coeff = 0.25 + fatigue * 0.35;
    comb_lp = comb_lp + (delayed - comb_lp) * d_coeff;
    comb_d.write(body_input + comb_lp * fb);
    body_out = delayed * 1.3;
} else if (body_type < 2.5) {
    // Type 2: Pressure Cavity — more dramatic compression, higher feedback ceiling
    cav_len = clamp(samplerate / base_freq, 2, 8000);
    cav_fb = eff_Q * (0.88 + pressure * 0.1);
    cav_fb = clamp(cav_fb, 0, 0.996);
    cav_del = cav_d.read(cav_len);
    cav_cut = 0.15 + (1 - pressure) * 0.35 + eff_heat * 0.3;
    cav_lp = cav_lp + (cav_del - cav_lp) * cav_cut;
    cav_d.write(body_input + cav_lp * cav_fb);
    // Resonator on top for tonal color
    w1 = twopi * body_freq * 1.0 / samplerate;
    r1 = eff_Q * 0.97;
    ya = cav_del + 2 * r1 * cos(w1) * ry1_a - r1 * r1 * ry2_a;
    ry2_a = ry1_a; ry1_a = ya;
    body_out = (cav_del * 0.35 + ya * 0.65) * 1.2;
} else {
    // Type 3: Membrane (Bessel mode ratios) — higher Q for longer sustain
    mem_r1 = 1.0;
    mem_r2 = 1.594;
    mem_r3 = 2.136;
    mem_r4 = 2.296;
    w1 = twopi * body_freq * mem_r1 / samplerate;
    r1 = eff_Q * 0.999;
    ya = body_input + 2 * r1 * cos(w1) * ry1_a - r1 * r1 * ry2_a;
    ry2_a = ry1_a; ry1_a = ya;
    w2 = twopi * body_freq * mem_r2 / samplerate;
    r2 = eff_Q * 0.995;
    yb = body_input + 2 * r2 * cos(w2) * ry1_b - r2 * r2 * ry2_b;
    ry2_b = ry1_b; ry1_b = yb;
    w3 = twopi * body_freq * mem_r3 / samplerate;
    r3 = eff_Q * 0.99;
    yc = body_input + 2 * r3 * cos(w3) * ry1_c - r3 * r3 * ry2_c;
    ry2_c = ry1_c; ry1_c = yc;
    w4 = twopi * body_freq * mem_r4 / samplerate;
    r4 = eff_Q * 0.985;
    yd = body_input + 2 * r4 * cos(w4) * ry1_d - r4 * r4 * ry2_d;
    ry2_d = ry1_d; ry1_d = yd;
    body_out = (ya * 0.55 + yb * 0.3 + yc * 0.2 + yd * 0.15) * 1.1;
}

// ── FRACTURE (asymmetric wavefold) ──
fold_d = 1 + eff_scar * 4;
fractured = body_out;
if (eff_scar > 0.01) {
    biased = body_out + pressure * 0.3;
    folded = asin(sin(biased * fold_d * 1.5707963)) * 0.6366197;
    fractured = body_out * (1 - eff_scar) + folded * eff_scar;
}

// ── FEEDBACK SOURCE (clean at low stress, fractured at high stress) ──
// At stress=0: clean body feeds back (ghost resonance, musical)
// At stress=1: fractured signal feeds back (harsh screech harmonics)
fb_source = body_out * (1 - eff_stress) + fractured * eff_stress;
fb_state = fb_source;

// ── OUTPUT ENVELOPE ──
// main_env = standard decay (uses non-linear eff_decay)
// halo_env * mist extends for feedback voices
env_rate = 1.0 / max(eff_decay * samplerate / 1000, 1);
main_env = main_env * (1 - env_rate);

bl_env = halo_env * eff_mist;
out_env = max(main_env, bl_env);
raw_out = fractured * out_env * 3;
out1 = tanh(raw_out) * 0.95;
